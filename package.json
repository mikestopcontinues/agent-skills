{
  "name": "@mikestopcontinues/agent-skills",
  "version": "0.2.0",
  "private": true,
  "description": "Harness-neutral engineering toolkit — TS canonical sources for skills, agents, and hooks, with per-harness bundle emit (Claude Code, Codex, OpenCode).",
  "type": "module",
  "main": "./opencode/src/plugin.ts",
  "files": [
    "claude/",
    "codex/",
    "opencode/",
    ".claude-plugin/",
    ".agents/",
    "README.md",
    "CLAUDE.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engineStrict": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^24",
    "pnpm": "^10"
  },
  "scripts": {
    "build": "node generator/build.ts",
    "dev": "node --watch-path=generator/canonical-sources --watch-path=generator/emit --watch-path=generator/factories --watch-path=generator/aliases generator/build.ts",
    "check": "run-s check:type check:lint check:test check:bundles",
    "check:type": "tsc --noEmit",
    "check:lint": "eslint .",
    "check:test": "vitest run --passWithNoTests",
    "check:bundles": "node generator/build.ts && git diff --quiet claude/ codex/ opencode/ .claude-plugin/ .agents/ || (echo 'Bundles drifted — run pnpm build and commit the result' && exit 1)",
    "type": "tsc --noEmit",
    "type:watch": "tsc --noEmit --watch",
    "lint": "eslint . --fix",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "release": "node tools/release.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "@vitest/eslint-plugin": "^1.1.0",
    "eslint": "^9.0.0",
    "npm-run-all2": "^8.0.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "glob": "^11.0.0",
    "valibot": "^1.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
